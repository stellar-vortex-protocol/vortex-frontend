# Environment variables — defined and validated by src/lib/env-schema.mjs.
# See docs/configuration.md. `npm run check:env` fails if this file drifts.

# ─── Relay API ──────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000  # Base URL of the vortex-backend REST API (https:// required in production)
NEXT_PUBLIC_WS_URL=ws://localhost:4000/ws  # WebSocket endpoint for the live intent feed (wss:// in production; unset disables live updates)

# ─── Site ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000  # Canonical site origin, used to build absolute Open Graph / Twitter image URLs (set to your deployed domain in production)

# ─── Stellar ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_NETWORK=testnet  # Stellar network to connect to: testnet | futurenet | mainnet

# Deployed contract IDs (leave blank until deployed; otherwise 56-character C... contract IDs)
NEXT_PUBLIC_SETTLEMENT_CONTRACT=  # Contract ID for the settlement contract on the chosen network
NEXT_PUBLIC_SOLVER_REGISTRY_CONTRACT=  # Contract ID for the solver registry contract on the chosen network

# Optional feature flags
NEXT_PUBLIC_SLASH_EVENTS_MOCK=false  # Set to true to serve mock solver penalty events until the relay exposes /slash-events

# Solver bond management UI at /solve/manage (issue #451).
# unset/off = hidden (404), "1" = live bond API, "mock" = in-memory mock adapter.
NEXT_PUBLIC_FEATURE_BOND_MGMT=

# Solver bond management UI at /solve/manage (issue #451).
# unset/off = hidden (404), "1" = live bond API, "mock" = in-memory mock adapter.
NEXT_PUBLIC_FEATURE_BOND_MGMT=
