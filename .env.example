# Environment variables — defined and validated by src/lib/env-schema.mjs.
# See docs/configuration.md. `npm run check:env` fails if this file drifts.
#
# Required/optional below matches scripts/env-manifest.mjs and
# config/environments/*.json: [required] = must be set in every environment,
# [required: preview, production] = must be set there but not in development,
# [optional] = safe to leave unset or empty.

# ─── Backend (relay API) ────────────────────────────────────────────────
# REST + WebSocket endpoints of the vortex-backend relay; both must share a domain.
NEXT_PUBLIC_API_URL=http://localhost:4000  # [required] Base URL of the vortex-backend REST API (https:// required in production)
NEXT_PUBLIC_WS_URL=ws://localhost:4000/ws  # [required: preview, production] WebSocket endpoint for the live intent feed (wss:// in production; unset disables live updates)

# ─── Stellar network & contracts ────────────────────────────────────────
# Network selection and deployed Soroban contract IDs.
NEXT_PUBLIC_NETWORK=testnet  # [required] Stellar network to connect to: testnet | futurenet | mainnet
NEXT_PUBLIC_SETTLEMENT_CONTRACT=  # [optional] Settlement contract ID on the chosen network (blank until deployed; otherwise 56-character C... ID)
NEXT_PUBLIC_SOLVER_REGISTRY_CONTRACT=  # [optional] Solver registry contract ID on the chosen network (blank until deployed; otherwise 56-character C... ID)

# ─── Site ───────────────────────────────────────────────────────────────
# Canonical origin used for absolute Open Graph / Twitter image URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000  # [required: preview, production] Canonical site origin (set to your deployed domain in production)

# ─── Analytics & feature flags ──────────────────────────────────────────
# Optional toggles for mock data and in-progress features; leave unset in production.
NEXT_PUBLIC_SLASH_EVENTS_MOCK=false  # [optional] Set to true to serve mock solver penalty events until the relay exposes /slash-events
NEXT_PUBLIC_MOCK_API=  # [optional] Set to 1 to serve the MSW mock API in the browser (npm run dev:mock sets this for you; ignored in production)
NEXT_PUBLIC_FEATURE_BOND_MGMT=  # [optional] Solver bond management UI at /solve/manage (issue #451): unset/off = hidden (404), "1" = live bond API, "mock" = in-memory mock adapter

# ─── Monitoring & server-only integrations ──────────────────────────────
# Server-side credentials; never prefix these with NEXT_PUBLIC_.
GITHUB_TOKEN=  # [optional] Read-only GitHub token for /api/contributors (raises rate limit; responses cached 1 h)
