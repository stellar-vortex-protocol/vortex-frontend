{
  "name": "vortex-frontend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "20"
  },
  "scripts": {
    "dev": "next dev",
    "dev:mock": "NEXT_PUBLIC_MOCK_API=1 next dev",
    "build": "node scripts/check-env-vars.mjs && next build",
    "start": "next start",
    "lint": "next lint",
    "check:editorconfig": "editorconfig-checker",
    "check:env": "node scripts/check-env-vars.mjs",
    "gen:api": "node scripts/gen-api.mjs",
    "check:contract": "node scripts/gen-api.mjs --check",
    "typecheck": "tsc --noEmit",
    "typecheck:storybook": "tsc --noEmit -p tsconfig.storybook.json",
    "check:stories": "node scripts/check-story-coverage.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run",
    "test:mutation:incremental": "stryker run --incremental",
    "check:mutation-summary": "node scripts/mutation-summary.mjs",
    "test:e2e": "playwright test",
    "check:no-empty-modules": "node scripts/check-no-empty-modules.mjs",
    "check:single-ssrf-guard": "node scripts/check-single-ssrf-guard.mjs",
    "check:i18n": "node scripts/check-i18n-parity.mjs",
    "check:orphan-tests": "node scripts/check-orphan-tests.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "check:manifest": "node scripts/check-manifest.mjs",
    "check:dependencies": "node scripts/check-dependencies.mjs",
    "check:lockfile": "node scripts/lint-lockfile.mjs",
    "check:deps": "node scripts/check-dependency-policy.mjs",
    "check:provenance": "node scripts/verify-provenance.mjs",
    "sbom": "node scripts/generate-sbom.mjs sbom.json",
    "changelog": "node scripts/generate-changelog.mjs",
    "dependency-report": "node scripts/dependency-diff-report.mjs",
    "build:storybook": "storybook build --quiet",
    "test:storybook": "test-storybook --url http://127.0.0.1:6006",
    "test:visual": "playwright test -c playwright.config.storybook.ts",
    "update:visual": "playwright test -c playwright.config.storybook.ts --update-snapshots",
    "check:actionlint": "actionlint",
    "doctor": "node scripts/doctor.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "@stellar/freighter-api": "^2.0.0",
    "@stellar/stellar-sdk": "^12.0.0",
    "@tanstack/react-virtual": "^3.10.9",
    "clsx": "^2.1.0",
    "framer-motion": "^11.2.10",
    "next": "14.2.3",
    "react": "^18",
    "react-dom": "^18",
    "swr": "^2.2.5",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@conventional-changelog/template": "^1.4.0",
    "@playwright/test": "^1.49.1",
    "@storybook/addon-a11y": "^10.5.5",
    "@storybook/nextjs-vite": "^10.5.5",
    "@storybook/test-runner": "^0.24.4",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^2.1.9",
    "autoprefixer": "^10",
    "editorconfig-checker": "^6.0.0",
    "eslint": "^8",
    "eslint-config-next": "14.2.3",
    "fast-check": "^3.0.0",
    "husky": "^9.1.7",
    "jsdom": "^24.1.3",
    "lint-staged": "^17.2.0",
    "msw": "^2.15.0",
    "postcss": "^8",
    "storybook": "^10.5.5",
    "tailwindcss": "^3.4.3",
    "typescript": "^5",
    "vitest": "^2.1.9"
  }
}
